{
	"name": "start-react-native",
	"version": "1.0.0",
	"main": "node_modules/expo/AppEntry.js",
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"format": "npx --yes prettier@3.9.6 --write .",
		"format:check": "npx --yes prettier@3.9.6 --check .",
		"verify": "npm run format:check && npx expo export --platform ios --output-dir dist",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.12.0",
		"axios": "^1.6.2",
		"expo": "~57.0.9",
		"expo-linear-gradient": "~57.0.1",
		"expo-splash-screen": "~57.0.5",
		"expo-status-bar": "~57.0.1",
		"react": "19.2.3",
		"react-native": "0.86.2",
		"react-native-svg": "15.15.4",
		"react-redux": "^9.3.0",
		"redux": "^5.0.1"
	},
	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@types/react": "^19.2.18",
		"react-native-svg-transformer": "^1.5.3",
		"typescript": "~6.0.3"
	},
	"private": true,
	"engines": {
		"node": ">=22.13.0 <25"
	}
}
